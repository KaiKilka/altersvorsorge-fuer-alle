---
const testimonials = [
  {
    quote: 'Ich dachte, Altersvorsorge sei kompliziert und teuer. Nach dem Gespräch hatte ich endlich einen klaren Plan — und das zu einem fairen Preis.',
    name: 'Sarah M.',
    age: 34,
    initials: 'SM',
  },
  {
    quote: 'Endlich jemand, der mir nichts verkaufen will. Die Beratung war ehrlich und auf meine Situation zugeschnitten.',
    name: 'Thomas K.',
    age: 42,
    initials: 'TK',
  },
  {
    quote: 'Als Selbstständige war ich völlig überfordert. Jetzt weiß ich genau, was ich tun muss — und habe ein gutes Gefühl dabei.',
    name: 'Lena B.',
    age: 29,
    initials: 'LB',
  },
];
---

<section class="bg-white py-24">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16" data-animate>
      <h2 class="font-display text-4xl md:text-5xl font-bold text-brand-navy mb-4">
        Was Klienten sagen
      </h2>
    </div>

    <div
      class="flex gap-6 overflow-x-auto snap-x snap-mandatory md:grid md:grid-cols-3 md:overflow-visible pb-4 md:pb-0 -mx-4 px-4 md:mx-0 md:px-0"
      role="list"
    >
      {testimonials.map((t, i) => (
        <div
          data-animate
          style={`transition-delay:${i * 120}ms`}
          class="snap-center shrink-0 w-[82vw] sm:w-[65vw] md:w-auto bg-white rounded-xl p-8 border border-brand-border shadow-sm hover:shadow-md transition-shadow duration-300 relative"
          role="listitem"
        >
          <div class="absolute top-6 right-8 font-display text-6xl leading-none text-brand-ice select-none" aria-hidden="true">"</div>

          <div class="flex gap-0.5 mb-5" aria-label="5 von 5 Sterne">
            {Array(5).fill(null).map(() => (
              <svg class="w-4 h-4 text-brand-sky" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
              </svg>
            ))}
          </div>

          <blockquote class="text-brand-ink/80 leading-relaxed mb-6 relative z-10 text-sm md:text-base">
            „{t.quote}"
          </blockquote>

          <div class="flex items-center gap-3">
            <div class="w-9 h-9 rounded-full bg-brand-ice border border-brand-border flex items-center justify-center text-brand-navy font-bold text-xs shrink-0" aria-hidden="true">
              {t.initials}
            </div>
            <div>
              <p class="font-semibold text-brand-ink text-sm">{t.name}</p>
              <p class="text-brand-slate text-xs">{t.age} Jahre</p>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
