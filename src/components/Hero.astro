---
---

<section class="relative overflow-hidden bg-brand-sky pt-16">
  <!-- Decorative background blobs -->
  <div class="absolute inset-0 overflow-hidden pointer-events-none" aria-hidden="true">
    <svg class="absolute -top-24 -right-24 w-[560px] h-[560px]" viewBox="0 0 560 560" fill="none">
      <ellipse cx="280" cy="280" rx="280" ry="240" fill="#3ECFB2" opacity="0.07" transform="rotate(-20 280 280)"/>
    </svg>
    <svg class="absolute -bottom-16 -left-16 w-[400px] h-[400px]" viewBox="0 0 400 400" fill="none">
      <circle cx="200" cy="200" r="200" fill="#FFB347" opacity="0.06"/>
    </svg>
  </div>

  <div class="relative max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-24 pb-32 grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
    <!-- Left: copy -->
    <div data-animate>
      <span class="inline-block text-brand-mint font-semibold text-xs tracking-widest uppercase mb-5">
        Unabhängig · Fair · Für alle
      </span>

      <h1 class="font-display text-5xl md:text-6xl lg:text-7xl font-bold text-brand-ink leading-[1.08] mb-6">
        Deine Rente.&nbsp;🌱<br />Deine Regeln.
      </h1>

      <p class="text-lg md:text-xl text-brand-ink/65 leading-relaxed mb-10 max-w-xl">
        Wir zeigen dir, wie du unabhängig von Versicherungen für dein Alter vorsorgen kannst — einfach, fair und zu einem Preis, der für alle passt.
      </p>

      <div class="flex flex-wrap gap-4 mb-10">
        <a
          href="#pakete"
          class="inline-flex items-center bg-brand-coral hover:bg-brand-coral/90 text-white px-8 py-4 rounded-full font-semibold text-lg transition-all duration-200 hover:scale-105 shadow-lg"
          style="box-shadow: 0 8px 24px rgba(255,107,107,0.35);"
        >
          Paket entdecken
        </a>
        <a
          href="#so-gehts"
          class="inline-flex items-center border-2 border-brand-ink/25 text-brand-ink hover:border-brand-ink hover:bg-brand-ink hover:text-white px-8 py-4 rounded-full font-semibold text-lg transition-all duration-200"
        >
          Wie funktioniert das?
        </a>
      </div>

      <div class="flex flex-col sm:flex-row sm:flex-wrap gap-3 sm:gap-6 text-sm font-medium text-brand-ink/70">
        <span class="flex items-center gap-2"><span>✅</span> Keine Versicherungsprovisionen</span>
        <span class="flex items-center gap-2"><span>✅</span> Festpreise ab 97&nbsp;€</span>
        <span class="flex items-center gap-2"><span>✅</span> Persönliche Beratung</span>
      </div>
    </div>

    <!-- Right: illustration -->
    <div class="relative flex items-center justify-center" data-animate style="transition-delay:150ms">
      <div class="relative w-full max-w-[420px] mx-auto">
        <!-- Plant/growth SVG illustration -->
        <svg viewBox="0 0 480 520" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full drop-shadow-xl" aria-hidden="true">
          <!-- Sky circle -->
          <circle cx="240" cy="240" r="210" fill="#EAF6FF" opacity="0.65"/>

          <!-- Coin stack -->
          <ellipse cx="240" cy="408" rx="78" ry="23" fill="#FFB347" opacity="0.2"/>
          <rect x="162" y="374" width="156" height="34" rx="9" fill="#FFB347" opacity="0.45"/>
          <rect x="166" y="358" width="148" height="34" rx="9" fill="#FFB347" opacity="0.7"/>
          <rect x="170" y="342" width="140" height="34" rx="9" fill="#F9A825"/>
          <text x="240" y="365" text-anchor="middle" fill="white" font-size="15" font-weight="700" font-family="system-ui,sans-serif" opacity="0.95">€ € €</text>

          <!-- Trunk -->
          <path d="M232,225 C233,265 237,305 240,342" stroke="#6B8F71" stroke-width="15" stroke-linecap="round" fill="none"/>

          <!-- Foliage layers -->
          <ellipse cx="240" cy="202" rx="102" ry="88"  fill="#3ECFB2" opacity="0.45"/>
          <ellipse cx="240" cy="170" rx="84"  ry="74"  fill="#3ECFB2" opacity="0.7"/>
          <ellipse cx="240" cy="136" rx="66"  ry="60"  fill="#3ECFB2" opacity="0.88"/>
          <ellipse cx="240" cy="104" rx="48"  ry="46"  fill="#2DC8AA"/>
          <ellipse cx="240" cy="76"  rx="30"  ry="32"  fill="#1BB89A"/>

          <!-- Side branches -->
          <ellipse cx="170" cy="196" rx="36" ry="22" fill="#3ECFB2" opacity="0.6" transform="rotate(-28 170 196)"/>
          <ellipse cx="310" cy="183" rx="36" ry="22" fill="#3ECFB2" opacity="0.6" transform="rotate(28 310 183)"/>

          <!-- Accent dots -->
          <circle cx="146" cy="272" r="9"  fill="#FF6B6B" opacity="0.7"/>
          <circle cx="338" cy="256" r="11" fill="#FFB347"  opacity="0.8"/>
          <circle cx="160" cy="130" r="7"  fill="#FF6B6B" opacity="0.55"/>
          <circle cx="324" cy="144" r="9"  fill="#FFB347"  opacity="0.65"/>
          <circle cx="136" cy="335" r="6"  fill="#3ECFB2" opacity="0.5"/>
          <circle cx="350" cy="315" r="8"  fill="#3ECFB2" opacity="0.5"/>

          <!-- Sparkle stars -->
          <path d="M296,58 L298,51 L300,58 L307,60 L300,62 L298,69 L296,62 L289,60 Z" fill="#FFB347" opacity="0.85"/>
          <path d="M175,92 L177,86 L179,92 L185,94 L179,96 L177,102 L175,96 L169,94 Z" fill="#FF6B6B" opacity="0.65"/>
        </svg>

        <!-- Floating badges -->
        <div class="absolute top-6 -left-2 md:-left-10 bg-white rounded-2xl shadow-xl px-4 py-3 flex items-center gap-2.5 border border-gray-50">
          <span class="text-xl" aria-hidden="true">🔒</span>
          <span class="font-semibold text-sm text-brand-ink">Unabhängig</span>
        </div>
        <div class="absolute top-[38%] -right-2 md:-right-10 bg-white rounded-2xl shadow-xl px-4 py-3 flex items-center gap-2.5 border border-gray-50">
          <span class="text-xl" aria-hidden="true">📊</span>
          <span class="font-semibold text-sm text-brand-ink">Dein Plan</span>
        </div>
        <div class="absolute bottom-12 -left-2 md:-left-8 bg-white rounded-2xl shadow-xl px-4 py-3 flex items-center gap-2.5 border border-gray-50">
          <span class="text-xl" aria-hidden="true">☀️</span>
          <span class="font-semibold text-sm text-brand-ink">Deine Zukunft</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Wave to white -->
  <div class="absolute bottom-0 left-0 right-0" aria-hidden="true">
    <svg viewBox="0 0 1440 70" fill="white" preserveAspectRatio="none" class="w-full" style="display:block;height:60px">
      <path d="M0,35 C240,70 480,0 720,35 C960,70 1200,0 1440,35 L1440,70 L0,70 Z"/>
    </svg>
  </div>
</section>
