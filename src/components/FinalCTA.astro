---
---

<section class="relative overflow-hidden" style="background: linear-gradient(135deg, #3ECFB2 0%, #EAF6FF 100%);">
  <!-- Decorative blobs -->
  <div class="absolute inset-0 pointer-events-none overflow-hidden" aria-hidden="true">
    <svg class="absolute -top-20 -left-20 w-72 h-72 opacity-20" viewBox="0 0 288 288" fill="none">
      <circle cx="144" cy="144" r="144" fill="white"/>
    </svg>
    <svg class="absolute -bottom-16 -right-16 w-64 h-64 opacity-15" viewBox="0 0 256 256" fill="none">
      <circle cx="128" cy="128" r="128" fill="#1A2B3C"/>
    </svg>
  </div>

  <div class="relative max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-28 text-center">
    <div data-animate>
      <h2 class="font-display text-4xl md:text-5xl lg:text-6xl font-bold text-brand-ink leading-tight mb-6">
        Starte heute. 🌱<br />Deine Zukunft dankt dir.
      </h2>
      <p class="text-xl text-brand-ink/70 max-w-xl mx-auto mb-10">
        Wähle dein Paket und buche dein erstes Gespräch — in unter 5 Minuten.
      </p>

      <a
        href="#pakete"
        class="inline-flex items-center bg-brand-coral hover:bg-brand-coral/90 text-white px-10 py-5 rounded-full font-bold text-xl transition-all duration-200 hover:scale-105 mb-6"
        style="box-shadow: 0 12px 32px rgba(255,107,107,0.4);"
      >
        Paket wählen →
      </a>

      <p class="text-sm text-brand-ink/55 font-medium">
        30 Tage Zufriedenheitsgarantie&nbsp;·&nbsp;Keine Abo-Falle&nbsp;·&nbsp;Sofort buchbar
      </p>
    </div>
  </div>
</section>
