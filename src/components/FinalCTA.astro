<section style="background: linear-gradient(135deg, #0F2A4A 0%, #1E5FA8 100%);" class="py-28">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <div data-animate>
      <h2 class="font-display text-4xl md:text-5xl lg:text-6xl font-bold text-white leading-tight mb-6">
        Starten Sie heute mit Ihrer Vorsorgeplanung.
      </h2>
      <p class="text-xl text-brand-sky max-w-xl mx-auto mb-10">
        Wählen Sie Ihr Paket und buchen Sie Ihr erstes Gespräch — in unter 5 Minuten.
      </p>

      <div class="flex flex-wrap justify-center gap-4 mb-8">
        <a
          href="#pakete"
          class="inline-flex items-center bg-white text-brand-navy px-9 py-4 rounded-lg font-bold text-lg hover:bg-brand-ice transition-colors duration-200 shadow-lg"
        >
          Paket wählen
        </a>
        <a
          href="#ueber-mich"
          class="inline-flex items-center border border-white/40 text-white px-9 py-4 rounded-lg font-semibold text-lg hover:bg-white/10 transition-colors duration-200"
        >
          Über mich
        </a>
      </div>

      <p class="text-sm text-white/50">
        30 Tage Zufriedenheitsgarantie · Keine Abo-Falle · Sofort buchbar
      </p>
    </div>
  </div>
</section>
