---
const cards = [
  {
    emoji: '🚫',
    title: 'Keine Provisionen',
    text: 'Wir verkaufen keine Versicherungen und verdienen keine Provision. Was wir empfehlen, ist wirklich das Beste für dich.',
    bg: 'bg-brand-soft',
  },
  {
    emoji: '💰',
    title: 'Faire Festpreise',
    text: 'Einmalige, transparente Preise. Kein Abo, keine Überraschungen.',
    bg: 'bg-brand-sky',
  },
  {
    emoji: '🧭',
    title: 'Dein persönlicher Plan',
    text: 'Kein Schema F. Wir analysieren deine Situation und erstellen einen maßgeschneiderten Fahrplan.',
    bg: 'bg-brand-mist',
  },
  {
    emoji: '🌍',
    title: 'Für alle gemacht',
    text: 'Egal ob Berufseinsteiger, Familie oder kurz vor der Rente — wir haben ein Paket für dich.',
    bg: 'bg-brand-soft',
  },
];
---

<section id="warum-wir" class="bg-white pt-20 pb-0">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pb-24">
    <div class="text-center mb-16" data-animate>
      <h2 class="font-display text-4xl md:text-5xl font-bold text-brand-ink mb-4">
        Warum wir anders sind 🤝
      </h2>
      <p class="text-xl text-brand-ink/60 max-w-2xl mx-auto leading-relaxed">
        Klassische Berater verdienen an Provisionen. Wir nicht. Unser Erfolg&nbsp;=&nbsp;dein Erfolg.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      {cards.map((card, i) => (
        <div
          data-animate
          style={`transition-delay: ${i * 100}ms`}
          class={`${card.bg} rounded-3xl p-8 border-2 border-transparent hover:border-brand-mint hover:shadow-xl hover:-translate-y-1 transition-all duration-300`}
        >
          <div class="text-4xl mb-5" aria-hidden="true">{card.emoji}</div>
          <h3 class="font-display text-xl font-bold text-brand-ink mb-3">{card.title}</h3>
          <p class="text-brand-ink/65 leading-relaxed text-sm md:text-base">{card.text}</p>
        </div>
      ))}
    </div>
  </div>

  <!-- Wave to brand-soft -->
  <svg viewBox="0 0 1440 70" fill="#FFF8F0" preserveAspectRatio="none" aria-hidden="true" style="display:block;margin-bottom:-2px">
    <path d="M0,35 C360,70 1080,0 1440,35 L1440,70 L0,70 Z"/>
  </svg>
</section>
