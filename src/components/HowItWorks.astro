---
const steps = [
  {
    number: '01',
    title: 'Paket wählen',
    text: 'Wählen Sie das Paket, das zu Ihrer Situation passt. Einmalige Zahlung, kein Abo.',
  },
  {
    number: '02',
    title: 'Fragebogen ausfüllen',
    text: 'In 10 Minuten teilen Sie mir Ihre Ziele, Ihren Lebensstandard und Ihre aktuelle Situation mit.',
  },
  {
    number: '03',
    title: 'Gespräch & Fahrplan',
    text: 'Im persönlichen Online-Gespräch erarbeite ich Ihren individuellen Altersvorsorge-Fahrplan.',
  },
];
---

<section id="so-gehts" class="bg-brand-ice py-24">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16" data-animate>
      <h2 class="font-display text-4xl md:text-5xl font-bold text-brand-navy mb-4">
        So funktioniert es
      </h2>
      <p class="text-xl text-brand-slate max-w-xl mx-auto">
        Drei Schritte bis zu Ihrem persönlichen Altersvorsorge-Fahrplan.
      </p>
    </div>

    <div class="relative grid grid-cols-1 md:grid-cols-3 gap-8">
      <div class="hidden md:block absolute top-7 left-[calc(16.67%+28px)] right-[calc(16.67%+28px)] border-t-2 border-dashed border-brand-border z-0" aria-hidden="true"></div>

      {steps.map((step, i) => (
        <div
          data-animate
          style={`transition-delay:${i * 130}ms`}
          class="relative z-10 flex flex-col items-center text-center"
        >
          <div class="w-14 h-14 rounded-full bg-brand-blue flex items-center justify-center text-white font-bold text-base mb-6 shadow-sm">
            {step.number}
          </div>
          <div class="bg-white rounded-xl p-8 border border-brand-border shadow-sm hover:shadow-md transition-shadow duration-300 w-full">
            <h3 class="font-display text-xl font-bold text-brand-navy mb-3">{step.title}</h3>
            <p class="text-brand-slate leading-relaxed text-sm">{step.text}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
